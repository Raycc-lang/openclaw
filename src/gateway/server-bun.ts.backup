type SubsystemLogger = ReturnType<typeof createSubsystemLogger>;

export type HooksRequestHandler = (req: Request) => Promise<Response | null>;

function isCanvasPath(pathname: string): boolean {
  return (
    pathname === A2UI_PATH ||
    pathname.startsWith(`${A2UI_PATH}/`) ||
    pathname === CANVAS_HOST_PATH ||
    pathname.startsWith(`${CANVAS_HOST_PATH}/`) ||
    pathname === CANVAS_WS_PATH
  );
}

function hasAuthorizedWsClientForIp(clients: Set<GatewayWsClient>, clientIp: string): boolean {
  for (const client of clients) {
    if (client.clientIp && client.clientIp === clientIp) {
      return true;
    }
  }
  return false;
}

async function authorizeCanvasRequest(params: {
  req: Request;
  auth: ResolvedGatewayAuth;
  trustedProxies: string[];
  clients: Set<GatewayWsClient>;
  remoteAddr?: string;
}): Promise<boolean> {
  const { req, auth, trustedProxies, clients, remoteAddr } = params;

  // Check if local request (simplified - Bun doesn't expose full socket details)
  const url = new URL(req.url);
  const hostname = url.hostname;
  if (hostname === "localhost" || hostname === "127.0.0.1" || hostname === "::1") {
    return true;
  }

  const token = getBearerTokenFromRequest(req);
  if (token) {
    // For Bun, we need to create a minimal IncomingMessage-like object
    const authResult = await authorizeGatewayConnect({
      auth: { ...auth, allowTailscale: false },
      connectAuth: { token, password: token },
      req: createIncomingMessageStub(req, remoteAddr),
      trustedProxies,
    });
    if (authResult.ok) {
      return true;
    }
  }

  const clientIp = resolveGatewayClientIp({
    remoteAddr: remoteAddr ?? "",
    forwardedFor: req.headers.get("x-forwarded-for") ?? undefined,
    realIp: req.headers.get("x-real-ip") ?? undefined,
    trustedProxies,
  });
  if (!clientIp) {
    return false;
  }
  return hasAuthorizedWsClientForIp(clients, clientIp);
}

function getBearerTokenFromRequest(req: Request): string | null {
  const auth = req.headers.get("authorization");
  if (!auth) return null;
  const match = /^Bearer\s+(.+)$/i.exec(auth);
  return match ? match[1] : null;
}

function createIncomingMessageStub(req: Request, remoteAddr?: string): any {
  const url = new URL(req.url);
  return {
    headers: Object.fromEntries(req.headers.entries()),
    url: req.url,
    socket: {
      remoteAddress: remoteAddr,
    },
  };
}

async function handleHttpRequest(params: {
  req: Request;
  canvasHost: CanvasHostHandler | null;
  clients: Set<GatewayWsClient>;
  controlUiEnabled: boolean;
  controlUiBasePath: string;
  controlUiRoot?: ControlUiRootState;
  openAiChatCompletionsEnabled: boolean;
  openResponsesEnabled: boolean;
  openResponsesConfig?: import("../config/types.gateway.js").GatewayHttpResponsesConfig;
  handleHooksRequest: HooksRequestHandler;
  handlePluginRequest?: HooksRequestHandler;
  resolvedAuth: ResolvedGatewayAuth;
  remoteAddr?: string;
}): Promise<Response> {
  const {
    req,
    canvasHost,
    clients,
    controlUiEnabled,
    controlUiBasePath,
    controlUiRoot,
    openAiChatCompletionsEnabled,
    openResponsesEnabled,
    openResponsesConfig,
    handleHooksRequest,
    handlePluginRequest,
    resolvedAuth,
    remoteAddr,
  } = params;

  const configSnapshot = loadConfig();
  const trustedProxies = configSnapshot.gateway?.trustedProxies ?? [];

  // Try hooks handler
  const hooksResponse = await handleHooksRequest(req);
  if (hooksResponse) {
    return hooksResponse;
  }

  // Try plugin handler
  if (handlePluginRequest) {
    const pluginResponse = await handlePluginRequest(req);
    if (pluginResponse) {
      return pluginResponse;
    }
  }

  // Try tools invoke
  const toolsResponse = await handleToolsInvokeHttpRequestBun(req, {
    auth: resolvedAuth,
    trustedProxies,
    remoteAddr,
  });
  if (toolsResponse) {
    return toolsResponse;
  }

  // Try open responses
  if (openResponsesEnabled) {
    const openResponsesResponse = await handleOpenResponsesHttpRequestBun(req, {
      auth: resolvedAuth,
      config: openResponsesConfig,
      trustedProxies,
      remoteAddr,
    });
    if (openResponsesResponse) {
      return openResponsesResponse;
    }
  }

  // Try OpenAI
  if (openAiChatCompletionsEnabled) {
    const openAiResponse = await handleOpenAiHttpRequestBun(req, {
      auth: resolvedAuth,
      trustedProxies,
      remoteAddr,
    });
    if (openAiResponse) {
      return openAiResponse;
    }
  }

  // Try canvas
  if (canvasHost) {
    const url = new URL(req.url);
    if (isCanvasPath(url.pathname)) {
      const ok = await authorizeCanvasRequest({
        req,
        auth: resolvedAuth,
        trustedProxies,
        clients,
        remoteAddr,
      });
      if (!ok) {
        return new Response("Unauthorized", { status: 401 });
      }
    }
    const a2uiResponse = await handleA2uiHttpRequestBun(req);
    if (a2uiResponse) {
      return a2uiResponse;
    }
    const canvasResponse = await canvasHost.handleHttpRequestBun?.(req);
    if (canvasResponse) {
      return canvasResponse;
    }
  }

  // Try control UI
  if (controlUiEnabled) {
    const avatarResponse = handleControlUiAvatarRequestBun(req, {
      basePath: controlUiBasePath,
      resolveAvatar: (agentId) => resolveAgentAvatar(configSnapshot, agentId),
    });
    if (avatarResponse) {
      return avatarResponse;
    }
    const controlUiResponse = handleControlUiHttpRequestBun(req, {
      basePath: controlUiBasePath,
      config: configSnapshot,
      root: controlUiRoot,
    });
    if (controlUiResponse) {
      return controlUiResponse;
    }
  }

  return new Response("Not Found", { status: 404 });
}

